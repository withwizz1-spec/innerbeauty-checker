# 식품안전나라 오픈API 인증키 (건강기능식품 품목제조신고(원재료) - C003)
FOOD_SAFETY_API_KEY=your_key_here

# 공공데이터포털(data.go.kr) 인증키 — HACCP 제품정보 · 수입식품 한글표시사항 공용
DATA_GO_KR_API_KEY=your_key_here

# 네이버 오픈API (developers.naver.com에서 앱 등록 후 발급) — 제품 이미지 보강용
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# 사용자 로그인 토큰(JWT) 서명용 비밀키 — 절대 외부에 노출되면 안 됨
# 생성 예: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=your_secret_here

# Railway Postgres 접속 문자열 (Public Network 연결 문자열 — 로컬에서 접속하려면 이게 필요)
# 개발용/테스트용 데이터베이스를 분리해서 씀
DATABASE_URL=postgresql://user:password@host:port/innerbeauty_dev
TEST_DATABASE_URL=postgresql://user:password@host:port/innerbeauty_test

# 배포된 프론트엔드(Vercel) origin — CORS 허용 목적. 로컬 개발은 allow_origin_regex로 이미 허용되므로 불필요
FRONTEND_URL=https://your-app.vercel.app
